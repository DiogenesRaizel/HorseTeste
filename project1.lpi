<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="My Application"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="zcomponentdesign"/>
      </Item>
      <Item>
        <PackageName Value="zcomponent"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="project1.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="src/Controller/uprodutocontroller.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uProdutoController"/>
      </Unit>
      <Unit>
        <Filename Value="src/Service/uprodutoservice.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uProdutoService"/>
      </Unit>
      <Unit>
        <Filename Value="src/Repository/uprodutorepositorymemoria.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uProdutoRepositoryMemoria"/>
      </Unit>
      <Unit>
        <Filename Value="src/Repository/uprodutorepository.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uProdutoRepository"/>
      </Unit>
      <Unit>
        <Filename Value="src/DataModule/udm.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="DM"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="DataModule"/>
        <UnitName Value="uDM"/>
      </Unit>
      <Unit>
        <Filename Value="src/Repository/uprodutorepositoryzeos.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="uProdutoRepositoryZeos"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="project1"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="modules/.dcp;modules/.dcu;modules;modules/github_com_hashload_horse/src;modules/github_com_hashload_jhonson/src;src/Controller;src/Service;src/Repository;src/DataModule"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
      <Item>
        <Name Value="EHTTP"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
