{$MODE DELPHI}{$H+}

uses
  cthreads,
  SysUtils,
  Horse,
  fpjson,
  jsonparser;

{
procedure GetProduto(Req: THorseRequest; Res: THorseResponse);
var
  LId: string;
begin
  LId := Req.Params['id'];

  Res.Send('Produto: ' + LId);
end;

begin
  THorse.Get('/produtos/:id', GetProduto);
  THorse.Listen(9000);
end.
}

{
procedure GetProdutos(Req: THorseRequest; Res: THorseResponse);
var
  LNome: string;
begin
  LNome := Req.Query['nome'];

  Res.Send('Nome: ' + LNome);
end;

begin
  THorse.Get('/produtos', GetProdutos);
  THorse.Listen(9000);
end.
}
{
procedure PostProduto(Req: THorseRequest; Res: THorseResponse);
begin
  Res.Send('Body: ' + Req.Body);
end;

begin
  THorse.Post('/produtos', PostProduto);
  THorse.Listen(9000);
end.
}
{
procedure PostProduto(Req: THorseRequest; Res: THorseResponse);
begin
  Res.Send(Req.Body);
end;

begin
  THorse.Post('/produtos', PostProduto);
  THorse.Listen(9000);
end.
}

{
procedure PostProduto(Req: THorseRequest; Res: THorseResponse);
var
  LJson: TJSONData;
  LObj: TJSONObject;
  LNome: string;
  LPreco: Double;
  LEstoque: Integer;
begin
  LJson := GetJSON(Req.Body);
  try
    LObj := LJson as TJSONObject;

    LNome := LObj.Get('nome', '');
    LPreco := LObj.Get('preco', 0.0);
    LEstoque := LObj.Get('estoque', 0);

    Res.Send(
      'Nome: ' + LNome +
      ' | Preço: ' + FloatToStr(LPreco) +
      ' | Estoque: ' + IntToStr(LEstoque)
    );
  finally
    LJson.Free;
  end;
end;
}

{
procedure PostProduto(Req: THorseRequest; Res: THorseResponse);
var
  LJson: TJSONData;
  LObj: TJSONObject;
  LResposta: TJSONObject;
begin
  LJson := GetJSON(Req.Body);
  try
    LObj := LJson as TJSONObject;

    LResposta := TJSONObject.Create;
    try
      LResposta.Add('mensagem', 'Produto recebido');
      LResposta.Add('nome', LObj.Get('nome', ''));
      LResposta.Add('preco', LObj.Get('preco', 0.0));
      LResposta.Add('estoque', LObj.Get('estoque', 0));

      Res.ContentType('application/json');
      Res.Send(LResposta.AsJSON);
    finally
      LResposta.Free;
    end;
  finally
    LJson.Free;
  end;
end;

begin
  THorse.Post('/produtos', PostProduto);
  THorse.Listen(9000);
end.
}


procedure GetProdutos(Req: THorseRequest; Res: THorseResponse);
var
  LLista: TJSONArray;
  LProduto: TJSONObject;
begin
  LLista := TJSONArray.Create;
  try
    LProduto := TJSONObject.Create;
    LProduto.Add('id', 1);
    LProduto.Add('nome', 'Arroz 5kg');
    LProduto.Add('preco', 25.90);
    LProduto.Add('estoque', 10);
    LLista.Add(LProduto);

    LProduto := TJSONObject.Create;
LProduto.Add('id', 2);
LProduto.Add('nome', 'Feijão 1kg');
LProduto.Add('preco', 8.50);
LProduto.Add('estoque', 20);
LLista.Add(LProduto);

    Res.ContentType('application/json');
    Res.Send(LLista.AsJSON);


  finally
    LLista.Free;
  end;
end;

begin
  THorse.Get('/produtos', GetProdutos);
  THorse.Listen(9000);
end.
